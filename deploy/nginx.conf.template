# RestAI на собственном сервере (замена Vercel).
# Генерируется deploy/setup.sh: __GUEST_DOMAIN__ / __WAITER_DOMAIN__ подставляются.
# HTTPS добавляет certbot (deploy/enable-https.sh) уже после переключения DNS.

# Кэш публичных GET /api/menu и /api/branding — замена Vercel Edge-кэша:
# тысячи гостей одного ресторана получают меню из кэша, а не бьют в Supabase.
proxy_cache_path /var/cache/nginx/restai_api levels=1:2 keys_zone=restai_api:10m max_size=200m inactive=10m use_temp_path=off;

# ---------- Гостевое приложение ----------
server {
    listen 80;
    server_name __GUEST_DOMAIN__;

    root /opt/restai/RestAI/dist;
    index index.html;
    client_max_body_size 2m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location ~ ^/api/(menu|branding)$ {
        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_cache restai_api;
        proxy_cache_key $request_uri;
        proxy_cache_valid 200 60s;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503;
        proxy_cache_background_update on;
        proxy_cache_lock on;
        add_header X-Cache $upstream_cache_status always;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 30s;
    }

    # Service worker и index.html не кэшируем — иначе гости застрянут на старой версии.
    location ~ ^/(sw\.js|service-worker\.js|registerSW\.js|index\.html|manifest\.webmanifest)$ {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    # Собранные vite-ассеты с хэшем в имени — кэшируем надолго.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

# ---------- Приложение официанта ----------
server {
    listen 80;
    server_name __WAITER_DOMAIN__;

    root /opt/restai/Waiter-app/dist;
    index index.html;
    client_max_body_size 2m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /api/ {
        proxy_pass http://127.0.0.1:3002;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # ИИ-подсказки ходят в DeepSeek — даём запас по времени.
        proxy_read_timeout 60s;
    }

    location ~ ^/(sw\.js|service-worker\.js|registerSW\.js|index\.html|manifest\.webmanifest)$ {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
