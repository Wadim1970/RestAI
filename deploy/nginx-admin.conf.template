# Панель администратора ресторана (Admin-restai) — статика + /api/ сервера официанта.
# Генерируется deploy/setup-admin.sh: __ADMIN_DOMAIN__ подставляется.
# HTTPS добавляет certbot (deploy/enable-https.sh admin).
server {
    listen 80;
    server_name __ADMIN_DOMAIN__;

    root /opt/restai/Admin-restai/dist;
    index index.html;
    client_max_body_size 2m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Те же функции, что на домене официанта (api/admin/*, api/pairings/*):
    # админка ходит на свой же адрес — без запросов на чужой домен.
    location /api/ {
        proxy_pass http://127.0.0.1:3002;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Аналитика за месяц и пересчёт пар блюд — даём запас по времени.
        proxy_read_timeout 120s;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
