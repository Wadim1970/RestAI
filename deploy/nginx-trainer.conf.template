# Тренажёр официанта (Trainer-RestAI) — статика PWA + /api/ в процесс api-server (pm2, порт 3003).
# Генерируется deploy/setup-trainer.sh: __TRAINER_DOMAIN__ и __TRAINER_DIR__ подставляются.
# HTTPS добавляет certbot (deploy/enable-https.sh trainer).
server {
    listen 80;
    server_name __TRAINER_DOMAIN__;

    root __TRAINER_DIR__/dist;
    index index.html;
    client_max_body_size 1m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /api/ {
        proxy_pass http://127.0.0.1:3003;
        proxy_set_header Host $host;
        # Лимит попыток входа по коду считает адрес, который дописывает именно nginx:
        # заголовок перезаписываем, а не добавляем к присланному клиентом (его можно подделать).
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 60s;
    }

    # Сервис-воркер и манифест не кэшируем: обновление приложения должно доходить сразу.
    location = /sw.js                { add_header Cache-Control "no-cache"; try_files $uri =404; }
    location = /manifest.webmanifest { add_header Cache-Control "no-cache"; try_files $uri =404; }
    location = /index.html           { add_header Cache-Control "no-cache"; }

    # Шаблоны писем: их по адресу забирает Supabase Auth (GOTRUE_MAILER_TEMPLATES_*).
    location /mail/ {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
