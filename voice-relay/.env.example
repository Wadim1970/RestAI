# ============================================================
# voice-relay — сервис-ретранслятор голосового ИИ (OpenAI Realtime).
# Живёт ОТДЕЛЬНО от waiter-api — тот стоит на Cloud.ru (Россия), туда
# OpenAI не пропустит соединение. Этот сервис должен стоять на сервере
# в Казахстане (там же, где сейчас n8n) — исходящее соединение к OpenAI
# тогда идёт с казахстанского IP, а не российского.
# ============================================================

# Порт, на котором слушает сервис
PORT=8081

# Домен фронта гостя (через запятую, если их несколько)
CORS_ORIGIN=https://guest.restai.pro

# Какой провайдер обслуживает голосовые сессии: gptlive | openai | grok
# Переключение — целиком через этот флаг + перезапуск pm2, без деления по
# сессиям. gptlive = OpenAI GPT-Live-1 (полный дуплекс, эндпоинт
# v1/live/sessions, делегирование рассуждений бэкенд-модели). openai/grok =
# Realtime API (v1/realtime). Grok совместим по протоколу с OpenAI Realtime
# (https://docs.x.ai/developers/model-capabilities/audio/voice-agent).
VOICE_PROVIDER=gptlive

# --- OpenAI Realtime (VOICE_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=alloy

# --- OpenAI GPT-Live-1 (VOICE_PROVIDER=gptlive) — тот же OPENAI_API_KEY ---
OPENAI_LIVE_MODEL=gpt-live-1
# Голос GPT-Live (свой набор имён, напр. marin). Можно задать и на ресторан:
# character_profile.voice.gptlive_voice.
OPENAI_LIVE_VOICE=marin
# Бэкенд-модель делегирования (рассуждения + инструменты call_waiter/меню).
# Уточните доступный id в своём аккаунте OpenAI.
OPENAI_LIVE_BACKEND_MODEL=gpt-5.6-terra
# 0 — не подталкивать первое приветствие response.create'ом (если GPT-Live
# здоровается сам и получается двойное приветствие).
GPTLIVE_NUDGE_GREETING=1
# --- WebRTC (основной путь при VOICE_PROVIDER=gptlive) ---
# Телефон ⇄ relay ⇄ GPT-Live: звук живым потоком (Opus), relay пересылает
# пакеты как есть; перебивание и эхоподавление работают как в звонке. Если
# у гостя WebRTC не поднялся за 6 с — телефон сам переходит на WebSocket.
# 0 — выключить WebRTC и пускать всех по WebSocket.
WEBRTC_ENABLED=1
# UDP-порты relay для звука (по 2 на разговор). Открыть на входящие в
# файрволе хостинга.
WEBRTC_PORT_MIN=40000
WEBRTC_PORT_MAX=40199
# Публичный IP — только если его НЕТ на сетевом интерфейсе (сервер за NAT).
WEBRTC_PUBLIC_IP=
# TURN (coturn) для сетей, режущих UDP. Заполняет deploy/setup-turn.sh:
# TURN_URLS=turn:voice.restai.space:3478?transport=udp,turn:voice.restai.space:3478?transport=tcp,turns:voice.restai.space:5349?transport=tcp
# TURN_SECRET=<генерируется скриптом, никому не пересылать>
TURN_URLS=
TURN_SECRET=

# 1 — пока у гостя звучит голос ИИ, relay шлёт в модель тишину вместо
# микрофона (проверка гипотезы «модель слышит себя из динамика и обрывает
# ответ»). Минус: гость не сможет перебить ИИ голосом. По умолчанию 0.
# Только для запасного WebSocket-пути.
MUTE_MIC_WHILE_AI_SPEAKS=0

# --- xAI Grok Voice Agent (используется только при VOICE_PROVIDER=grok) ---
GROK_API_KEY=
GROK_VOICE_MODEL=grok-voice-latest
# Встроенные голоса на выбор: eve (по умолчанию), ara, rex, sal, leo
GROK_VOICE=eve

# --- Supabase (тот же проект, что у фронта — анонимный ключ, НЕ секрет) ---
SUPABASE_URL=https://supabase.restai.pro
SUPABASE_ANON_KEY=

# Публичный, закэшированный на Vercel Edge эндпоинт меню RestAI —
# используется вместо отдельного похода в Supabase за карточками блюд.
MENU_API_BASE_URL=https://guest.restai.pro

# Бэкенд Waiter-app (server/) — для push-уведомления официанту после
# голосового вызова (call_waiter). Без этой переменной сам вызов всё
# равно создастся (Realtime-канал у официанта отработает), просто не
# продублируется push-ом для свёрнутого приложения.
WAITER_API_URL=

# Максимум одновременных голосовых разговоров. Держим с запасом ниже
# теоретического потолка по TPM для gpt-realtime на Tier 1 OpenAI (см.
# Settings -> Limits в кабинете OpenAI; на Tier 1 это ~20-40 разговоров
# при 40 000 TPM, точная цифра зависит от того, насколько непрерывно
# говорят гости). Поднимите, когда перейдёте на более высокий тир.
MAX_CONCURRENT_SESSIONS=15
